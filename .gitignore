# Runtime & secrets
.env
.env.*
!.env.example
/.env.backup
/.env.bak
auth.json
/dont_delete_install.lock
/install.lock
/update.lock
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
